# Environment Configuration
NODE_ENV=development
PORT=3000
HOST=localhost

# Logging
LOG_LEVEL=info

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# Cache Configuration
CACHE_TTL=3600000
CACHE_MAX=1000
